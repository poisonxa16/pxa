# PXA Overdrive -- draft preset for Qwen3.8-Flash-Next (PXQN2) on one V100
#
# Model : the Flash-Next PXQN2 file
# Cards : 1x Tesla V100 16 GB (sm_70) + system RAM
#
# UNMEASURED DRAFT (W1, 2026-10-11): there is no V100 timing in this file. Do not treat it as a 70 t/s claim.
#
# Since 2026-10-19 the Overdrive switch set is not written out in this file: the engine applies it itself at
# startup (PXA_AUTO_OVERDRIVE, on by default) when it reads this class out of the model file and the file is larger
# than the card. The set and the decision that applies it live in the PXQN library, so on a build without that
# library nothing is applied. This file carries the one line that forces the set (PXA_OVERDRIVE=1), the box rows
# an operator may have to adjust, and the site rows. PXA_NO_OVERDRIVE=1 turns the set off; a value you export for
# any one switch is kept. The set the engine applies is the frozen-residency recipe E, measured on one V100 at
# +17% prose / +27% code over the earlier preset arm (2026-10-14) and bit-for-bit repeatable there.
#
# The pool below sits on the node the card hangs off (node 0 here); set
# PXA_XCACHE_CPUPOOL_CPUS to that node's CPUs on your machine.
#
# The expert map is the learned one: <model>.expert-counts.csv beside the
# model, else the per-user cache. This preset does not hardcode a path.
# If no map is found the server profiles once, writes the map, and restarts.

# --- Overdrive: the engine applies the measured switch set for this class; =1 forces it even on a card the file
# would fit (the class itself must match), =0 turns it off like PXA_NO_OVERDRIVE=1 ---
PXA_OVERDRIVE=1
# Ring lending off for one V100 (4.0 RC2, 2026-10-29): with lending on, the long-prompt (prefill) ubatches read the lent
# cold experts in place over the link and prefill falls to ~75 t/s; off = 548-636 t/s, decode unchanged and the same
# output byte for byte. A value you export wins (=1 turns lending back on, for decode-heavy use).
PXA_XCACHE_RING_LEND=0

# --- box ---
# Node 0 only. Unmeasured arms, not selected: 0-15, and 0-17,36-53.
PXA_XCACHE_CPUPOOL_CPUS=0-17
# Bind the process to the GPU's NUMA node (node 0 when every visible card is there).
# Inside a container this needs --cap-add SYS_NICE.
PXA_NUMA_BIND=1

# --- site ---
# Pinned host memory is off, matching the P100 preset. The V100 on-vs-off arm
# is unmeasured: delete this line to turn pinning on.
GGML_CUDA_NO_PINNED=1
PXA_PLE_MMAP=2
CUDA_DEVICE_ORDER=PCI_BUS_ID

# sm_70 verify int8 (PXA_PXQN_V70_N3_VERIFY_I8) stays unset. It was a win on
# dense PXQN3, not on this PXQN2 MoE file. W2 owns that measurement.

# --- server arguments (draft, not timed) ---
#   -ot 'per_layer_token_embd\.weight=CPU' -ngl 99 -fa on -np 1 -t 18 --jinja
#   --no-context-shift --cache-ram 0 -c 16384 -ctk q8_0 -ctv q8_0
#   --spec-type mtp:n_max=4,p_min=0.75

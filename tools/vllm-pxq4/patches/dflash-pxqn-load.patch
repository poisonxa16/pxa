         return hidden_states, residual
 
 
+def _pxa_shift_pxqn_layer_keys(quant_config, start: int) -> None:
+    """Point PXQN module entries at the drafter's offset layer prefixes.
+
+    Also install the fused-module map. DFlash does not copy one onto the
+    draft quant config, so gate_up_proj never expands to gate_proj + up_proj
+    and the fused linear stays unquantized.
+    """
+    if quant_config is None or not hasattr(quant_config, "pxqn_modules"):
+        return
+    mapping = dict(getattr(quant_config, "packed_modules_mapping", None) or {})
+    mapping.setdefault("gate_up_proj", ["gate_proj", "up_proj"])
+    mapping.setdefault("qkv_proj", ["q_proj", "k_proj", "v_proj"])
+    quant_config.packed_modules_mapping = mapping
+    mods = quant_config.pxqn_modules
+    if not mods or not start:
+        return
+    shifted = {}
+    for key, ent in mods.items():
+        parts = key.split(".")
+        if len(parts) >= 2 and parts[0] == "layers" and parts[1].isdigit():
+            parts[1] = str(int(parts[1]) + int(start))
+            shifted[".".join(parts)] = ent
+        else:
+            shifted[key] = ent
+    quant_config.pxqn_modules = shifted
+
+
 @support_torch_compile
 class DFlashQwen3Model(nn.Module):
     decoder_layer_cls = DFlashQwen3DecoderLayer

+# PXA_SWA_KEEP_HASHED=1 puts hashed blocks on the LRU end of the free queue
+# (evicted last), including blocks a sliding window released for immediate
+# reuse. Unset or 0 keeps this build's free order. Default off.
+_PXA_SWA_KEEP_HASHED = os.environ.get("PXA_SWA_KEEP_HASHED", "0") == "1"
+
+
+def _pxa_swa_split(freed, reuse_first, keep, caching):
+    """Return (prepend, append) for one free_blocks call.
+
+    keep off, or caching off: one append, caller order (this build's stock path).
+    keep on: unhashed blocks are recycled first; hashed blocks go to the LRU end
+    even when reuse_first is set.
+    """
+    if not keep or not caching:
+        return [], list(freed)
+    pre = [b for b in freed if b.block_hash is None]
+    post = [b for b in freed if b.block_hash is not None]
+    return pre, post
+
 

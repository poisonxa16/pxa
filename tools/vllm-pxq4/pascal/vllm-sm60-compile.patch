+def _demote_parameter_subclasses(model: nn.Module) -> int:
+    """Replace every non-exact nn.Parameter with a plain one over the same
+    storage.  Returns how many were replaced.  See the caller for why."""
+    replaced = 0
+    for module in model.modules():
+        for name, param in list(module.named_parameters(recurse=False)):

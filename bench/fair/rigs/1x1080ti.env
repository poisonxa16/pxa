# bench/fair rig: 1x GeForce GTX 1080 Ti 11 GB (sm_61).
#
# KEY=VALUE and comments only. Two of the three blocks are `pending` on this rig
# and the comments say exactly why. That is the honest state, not an oversight:
# 11 GB is the constraint, and there is no artifact in weights/MANIFEST.sha256
# that fits it and satisfies those blocks' rules.

RIG_NAME="1x1080ti"
RIG_DESC="1x GeForce GTX 1080 Ti 11 GB (sm_61)"
RIG_SOURCE="bench/fair-battle.md (GTX 1080 Ti, published PXQ2 tier vs a fresh upstream build), docs/COOKBOOK.md"
RIG_DEVICES=""

# --------------------------------------------------------------------------
# ENGINE-ONLY — pending, and it stays pending until an artifact exists.
# The block needs one file BOTH engines read, small enough for 11 GB. The
# published 1080 Ti comparison is this engine's PXQ2 against upstream's IQ2_KS:
# two different files, i.e. a PRODUCT row, which is where it is wired below.
# The IQ2_KS artifact cannot serve as a shared file either — IQ2_KS is one of
# the 53 ik quant type ids this engine retired on 2026-08-21 (ggml/include/ggml.h),
# so this engine refuses to load it at all. An MXFP4 or Q*_K conversion of the
# 35B tier under ~10 GB, with its sha in weights/MANIFEST.sha256, would fill it.
# The flags below are the published 1080 Ti protocol and are ready for that file.
# --------------------------------------------------------------------------
ENGINE_ONLY_MODEL="pending"
ENGINE_ONLY_ARGS="-ngl 99 -np 1 -c 8192 -b 2048 -ub 768 -fa on -ctk f16 -ctv f16"
ENGINE_ONLY_NOTE="no manifest artifact both engines can read fits 11 GB; the published 1080 Ti pair is two different files, which is the PRODUCT block."

# --------------------------------------------------------------------------
# CODEC-ONLY — pending. The block needs a PXQ4 file and an MXFP4 file of the
# same model at matched bytes; the manifest's matched-byte pair is the 27B one
# at 15.7 GB, which does not fit this card. A PXQ4/MXFP4 pair of a model small
# enough for 11 GB, both hashed in the manifest, would fill it.
# --------------------------------------------------------------------------
CODEC_PXQ_MODEL="pending"
CODEC_PXQ_BYTES=""
CODEC_REF_MODEL="pending"
CODEC_REF_BYTES=""
CODEC_ARGS="-ngl 99 -np 1 -c 8192 -b 2048 -ub 768 -fa on -ctk f16 -ctv f16"
CODEC_NOTE="no matched-byte PXQ4/MXFP4 pair in the manifest fits 11 GB."

# --------------------------------------------------------------------------
# PRODUCT — the published 1080 Ti comparison, both artifacts hashed in
# weights/MANIFEST.sha256.
# This engine: the published PXQ2 tier on the cookbook's bare 1080 Ti command
# line — no -b/-ub, no --ctx-checkpoints, no speculation flag. The engine
# recognises a single 1080 Ti, fills -b 2048 -ub 768 --ctx-checkpoints 0, and
# declines to auto-arm speculation on this card, printing both decisions.
# Upstream: its own IQ2_KS requantization of the same PXA-Fusion2-35B BF16
# source with the same imatrix, at the published protocol's explicit flags
# (upstream has no per-card table to fill them in).
# --------------------------------------------------------------------------
PRODUCT_PXA_MODEL="PXA-Fusion2-35B-PXQ2.gguf"
PRODUCT_PXA_ARGS="-ngl 99 -np 1 -c 8192 -fa on -ctk f16 -ctv f16"
PRODUCT_UP_MODEL="upstream-Fusion2-35B-IQ2_KS.gguf"
PRODUCT_UP_ARGS="-ngl 99 -np 1 -c 8192 -b 2048 -ub 768 -fa on -ctk f16 -ctv f16 --ctx-checkpoints 0"
# Same base weights: the manifest records the upstream file as a requantization
# of the PXA-Fusion2-35B BF16 source with its imatrix. Different codec, different
# engine, one model.
PRODUCT_SAME_BASE_WEIGHTS="yes"
PRODUCT_NOTE="cold-prefill numbers in bench/fair-battle.md were taken at -fa off; this rig runs the -fa on (chat) regime. Change -fa on both arms together or not at all."

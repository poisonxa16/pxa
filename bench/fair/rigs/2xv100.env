# bench/fair rig: 2x Tesla V100 16 GB (sm_70), PCIe.
#
# A rig file is KEY=VALUE and comments, nothing else — run.sh checks that before
# reading it. Every value here is either taken from a file in this repo (the
# comment says which) or the literal word `pending`. Nothing is guessed: a
# `pending` cell makes run.sh exit 2 instead of printing a number nobody can
# reproduce.
#
# Copy this file to rigs/<your rig>.env and edit it for your own cards.

RIG_NAME="2xv100"
RIG_DESC="2x Tesla V100 16 GB (sm_70), PCIe"
RIG_SOURCE="bench/fair-battle.md (2026-09-03 cross-engine, 2x V100), docs/COOKBOOK.md"
# CUDA indices of the two cards, from `nvidia-smi -L`. Empty = use every visible
# GPU. run.sh exports CUDA_DEVICE_ORDER=PCI_BUS_ID with it, so the indices mean
# the same thing on every boot.
RIG_DEVICES=""

# --------------------------------------------------------------------------
# ENGINE-ONLY — same GGUF, two engines.
# The file has to be one BOTH engines read, so it is a stock quant, not a PXQ
# file. MXFP4 here is not a codec choice: it is the single file the 2026-09-03
# three-engine table ran on all three engines (weights/MANIFEST.sha256).
# Flags: the protocol of that same table — "-c 32768 -b/-ub 2048 -fa on",
# temp 0, seed 42 — given verbatim to both arms. Identical, not tuned per arm:
# a tuned arm measures the tuning, not the engine.
# --------------------------------------------------------------------------
ENGINE_ONLY_MODEL="Qwable-27B-MXFP4-lite.gguf"
ENGINE_ONLY_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
ENGINE_ONLY_NOTE="MXFP4 on both arms: the only fairness this block claims is that the file, the card and the flags are identical and only the binary differs."

# --------------------------------------------------------------------------
# CODEC-ONLY — same engine, PXQ4 vs MXFP4 at matched bytes.
# Both files are conversions of the same Huihui Qwable-3.6-27B-abliterated F16
# GGUF, quantized with this repo's llama-quantize (weights/MANIFEST.sha256).
# Byte counts are from that manifest's own provenance comments.
# --------------------------------------------------------------------------
CODEC_PXQ_MODEL="Qwable-27B-PXQ4core.gguf"
CODEC_PXQ_BYTES="15,679,382,592"
CODEC_REF_MODEL="Qwable-27B-MXFP4-lite.gguf"
CODEC_REF_BYTES="15,672,025,920"
CODEC_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
CODEC_NOTE="0.05% apart in bytes, same base weights, same engine, same flags."

# --------------------------------------------------------------------------
# PRODUCT — best documented recipe per side. Not a controlled comparison: each
# side gets its own quant and its own best flags, which is the point.
# This engine: the PXQ4 core tier at -b 8192 -ub 2048, the measured best cell
# for a V100 pair (bench/fair-battle.md, "ours, folded build"; docs/COOKBOOK.md
# explains why -ub does not transfer between card sets).
# Upstream: its MXFP4 row's own configuration from the same table.
# --------------------------------------------------------------------------
PRODUCT_PXA_MODEL="Qwable-27B-PXQ4core.gguf"
PRODUCT_PXA_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 8192 -ub 2048 -fa on -ctk f16 -ctv f16"
PRODUCT_UP_MODEL="Qwable-27B-MXFP4-lite.gguf"
PRODUCT_UP_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
# Both sides quantize the same base weights, so this is a recipe comparison and
# not a model comparison.
PRODUCT_SAME_BASE_WEIGHTS="yes"
PRODUCT_NOTE="different quant and different -b/-ub per side, on purpose: each side at its own best."

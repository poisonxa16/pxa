# bench/fair rig: 4x Tesla P100-PCIE-16GB (sm_60), PCIe, no NVLink.
#
# KEY=VALUE and comments only. Every value is either sourced from a file in this
# repo (the comment says which) or the literal word `pending`; a `pending` cell
# makes run.sh exit 2 rather than print a number nobody can reproduce.

RIG_NAME="4xp100"
RIG_DESC="4x Tesla P100-PCIE-16GB (sm_60), PCIe, no NVLink"
RIG_SOURCE="bench/fair-battle.md (2026-09-03 cross-engine protocol), docs/COOKBOOK.md"
# CUDA indices of the four cards, from `nvidia-smi -L`. Empty = every visible GPU.
RIG_DEVICES=""

# --------------------------------------------------------------------------
# ENGINE-ONLY — same GGUF, two engines. MXFP4 because both engines read it;
# this is the file the 2026-09-03 three-engine table ran on all three engines.
# The flags are that table's protocol (-c 32768, -b/-ub 2048, -fa on), given
# verbatim to both arms. They are NOT a measured optimum for four cards: no
# published row exists for this card count, and an engine-only comparison wants
# both arms identical rather than each one tuned.
# --------------------------------------------------------------------------
ENGINE_ONLY_MODEL="Qwable-27B-MXFP4-lite.gguf"
ENGINE_ONLY_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
ENGINE_ONLY_NOTE="flags are the cross-engine protocol's, identical on both arms; they are not a tuned four-card configuration."

# --------------------------------------------------------------------------
# CODEC-ONLY — same engine, PXQ4 vs MXFP4 at matched bytes. Same pair and same
# byte counts as every other rig: both are conversions of the same Huihui
# Qwable-3.6-27B-abliterated F16 GGUF (weights/MANIFEST.sha256).
# --------------------------------------------------------------------------
CODEC_PXQ_MODEL="Qwable-27B-PXQ4core.gguf"
CODEC_PXQ_BYTES="15,679,382,592"
CODEC_REF_MODEL="Qwable-27B-MXFP4-lite.gguf"
CODEC_REF_BYTES="15,672,025,920"
CODEC_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
CODEC_NOTE="0.05% apart in bytes, same base weights, same engine, same flags."

# --------------------------------------------------------------------------
# PRODUCT — best documented recipe per side.
# This engine gets a BARE command line with no -b/-ub: four P100s are outside
# the card sets the batch table measured, so the documented recipe is to let the
# engine size them and print what it chose (README, "Reproduce the headline
# table"; docs/COOKBOOK.md on why -ub does not transfer). Upstream has no such
# table, so its arm keeps the explicit -b/-ub of its published row.
#
# The rig's own best-known recipe is the four-card hybrid-MoE one in
# docs/COOKBOOK.md ("4xp100-flashnext": -ts 5079,12612,12612,11897, -ot
# 'per_layer_token_embd\.weight=CPU', -c 150016 -b 2048 -ub 2048 -wgt 8 -t 16).
# It is not wired in here because its artifact is not published and has no sha
# in weights/MANIFEST.sha256 — quantize your own to that recipe, add its hash to
# the manifest, and point PRODUCT_PXA_MODEL at it.
# --------------------------------------------------------------------------
PRODUCT_PXA_MODEL="Qwable-27B-PXQ4core.gguf"
PRODUCT_PXA_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -fa on -ctk f16 -ctv f16"
PRODUCT_UP_MODEL="Qwable-27B-MXFP4-lite.gguf"
PRODUCT_UP_ARGS="-ngl 99 -sm layer -np 1 -c 32768 -b 2048 -ub 2048 -fa on -ctk f16 -ctv f16"
PRODUCT_SAME_BASE_WEIGHTS="yes"
PRODUCT_NOTE="this engine sizes -b/-ub itself on an unmeasured card set and prints the choice; upstream keeps its published row's explicit values."

# Copy to .env and edit. Everything here has a working default except the three
# marked REQUIRED — compose refuses to start without those rather than guessing.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# The directory on THIS machine that holds your model files. It is mounted
# read-only at /models inside the container.
MODELS_DIR=/path/to/your/models

# The .gguf file inside that directory — the file name only, not the full path.
MODEL_FILE=your-model.gguf

# Which cards to give the engine, as `nvidia-smi -L` numbers them, comma separated.
# One card:  0      Two cards: 0,1      A specific pair: 2,4      Everything: all
GPUS=0

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------

PXA_VERSION=v2026.10
PXA_PORT=8080

# Context window. Bigger costs VRAM; if the server exits during load, this is the
# first thing to halve.
CTX=8192

# Anything else you want on the server's command line. Two examples worth knowing:
#   -fa                      flash attention — on Volta, usually free speed
#   -sm tensor -ts 1,1       split one model ACROSS two identical cards that can
#                            talk to each other directly, rather than in layers
# PXA_EXTRA_FLAGS=-fa

# How long to allow for the model to load before the container is called unhealthy.
# A 27B model off a spinning disk can take minutes.
START_PERIOD=300s
SHM_SIZE=4gb

# ---------------------------------------------------------------------------
# The vLLM sidecar — only if you run `docker compose --profile vllm up`
# ---------------------------------------------------------------------------

# sm70 for V100, sm60 for P100.
VLLM_ARCH=sm70

# A CONVERTED CHECKPOINT DIRECTORY inside MODELS_DIR — not a .gguf. Make one with
# `python -m gguf_to_vllm.convert` (docs/VLLM.md).
VLLM_MODEL_DIR=your-converted-checkpoint

VLLM_PORT=8000
VLLM_GPUS=0,1
VLLM_TP=2
SERVED_NAME=pxa

# FLASH_ATTN_V100 on Volta. On Pascal set PASCAL_SDPA — Pascal has no tensor cores
# and the V100 kernel will not run there.
VLLM_ATTN=FLASH_ATTN_V100

# Fraction of each card's memory vLLM may take. 0.88 is the measured ceiling for a
# 27B model on 16 GB cards at TP=2; raising it aborts before the model loads.
VLLM_GMU=0.88
VLLM_MML=32768
VLLM_MNS=16

# vLLM captures CUDA graphs at start-up: about 3 minutes on Volta, about 6 on
# Pascal. Do not shorten this without watching a boot.
VLLM_START_PERIOD=900s
VLLM_SHM_SIZE=16gb
